// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  backlog
  progress
  done
}

enum TaskPriority {
  baja
  media
  alta
  urgente
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks    Task[]
  canvases Canvas[]
  diagrams Diagram[]
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String       @default("")
  status      TaskStatus   @default(backlog)
  priority    TaskPriority @default(media)
  tags        String[]     @default([])
  due         DateTime?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@index([projectId])
  @@index([status])
}

model Canvas {
  id        String   @id @default(cuid())
  name      String
  scene     Json     @default("{}")
  thumbnail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@index([projectId])
}

model Diagram {
  id        String   @id @default(cuid())
  name      String
  xml       String   @default("")
  thumbnail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@index([projectId])
}
